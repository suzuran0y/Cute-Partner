  "actions": [
    {
      "id": "ambient.ear_twitch",
      "label": "偶发耳鳍轻抖",
      "type": "ambient",
      "trigger": [
        "ear.left",
        "ear.right",
        "ear.both"
      ],
      "channels": [
        "ParamEarL",
        "ParamEarR"
      ],
      "restSeconds": [
        6,
        14
      ],
      "durationSeconds": 0.73,
      "occupancy": [
        "ears"
      ],
      "interruptible": true,
      "returnTo": "current_state_ear_pose"
    },
    {
      "id": "ambient.tail_sway",
      "label": "日常缓慢摆尾",
      "type": "ambient",
      "channels": [
        "ParamTailSway",
        "ParamTailTip"
      ],
      "basePeriodSeconds": 5.6,
      "occupancy": [
        "tail"
      ],
      "interruptible": true,
      "returnTo": "neutral_if_disabled"
    },
    {
      "id": "gesture.tail_swish",
      "label": "短时大幅摆尾",
      "type": "one_shot",
      "trigger": "tail.swish",
      "channels": [
        "ParamTailSway",
        "ParamTailTip"
      ],
      "durationSeconds": 2.8,
      "cycles": 2.5,
      "autoRestSeconds": [
        45,
        85
      ],
      "occupancy": [
        "tail"
      ],
      "blockedStates": [
        "working",
        "waiting",
        "error",
        "cancelled"
      ],
      "interruptible": true,
      "returnTo": "ambient.tail_sway",
      "fadeInSeconds": 0.24,
      "fadeOutSeconds": 0.55
    },
