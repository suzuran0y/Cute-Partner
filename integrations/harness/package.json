{
  "name": "dsh-cute-partner",
  "version": "1.0.1",
  "description": "Install and launch the Cute-Partner Windows desktop companion",
  "main": "index.cjs",
  "homepage": "https://github.com/suzuran0y/Cute-Partner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suzuran0y/Cute-Partner.git",
    "directory": "integrations/harness"
  },
  "os": ["win32"],
  "cpu": ["x64"],
  "files": [
    "index.cjs",
    "installer.cjs",
    "install-windows.ps1",
    "release.json",
    "README.md",
    "cordis.patch.yml",
    "locale",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.cjs",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json"
  },
  "engines": {
    "dsh": "=0.2.1-rc.2",
    "node": ">=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "desktop-companion",
    "live2d"
  ]
}
